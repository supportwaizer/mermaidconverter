<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_FederatedArchitectureReview_Flat" targetNamespace="http://example.com/federated-architecture-review">
  <bpmn:collaboration id="Collaboration_FAR_Flat">
    <bpmn:participant id="Participant_FAR_Flat" name="Federated Architecture Review" processRef="Process_FAR_Flat"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_FAR_Flat" name="Federated Architecture Review - All-in-One" isExecutable="false">
    <bpmn:laneSet id="LaneSet_FAR_Flat">
      <bpmn:lane id="Lane_APT" name="APT / Portfolio Reviewer">
        <bpmn:flowNodeRef>Start_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_CreateJira</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_CreateSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_UpdateInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_InProgress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Conduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_ConsultTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordAPTApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SA" name="Solution Architecture (SA)">
        <bpmn:flowNodeRef>S_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_UpdateInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_InProgress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Conduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_ConsultTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_RecordApprove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_RecordChanges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SAEndorse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_SAEndorsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReturnChanges</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ITG" name="IT Governance (ITG)">
        <bpmn:flowNodeRef>G_CreateTracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_CreateTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_VerifyApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_VerifyArtifacts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_RecordComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CorrectGovRecord</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Review" name="Review Request Initiated"/>
    <bpmn:userTask id="P_Submit" name="Submit Architecture Review Request via MS Form"/>
    <bpmn:userTask id="P_CreateJira" name="Create Architecture Review Jira Record"/>
    <bpmn:userTask id="P_CreateSub" name="Create Portfolio Review Jira Sub-task"/>
    <bpmn:userTask id="P_Upload" name="Attach Supporting Documentation"/>
    <bpmn:userTask id="P_Validate" name="Validate Review Documentation"/>
    <bpmn:exclusiveGateway id="P_Ready" name="Review Ready?"/>
    <bpmn:userTask id="P_UpdateInfo" name="Provide Required Information"/>
    <bpmn:userTask id="P_InProgress" name="Set Portfolio Review to In Progress"/>
    <bpmn:userTask id="P_Schedule" name="Schedule Portfolio Review, if Required"/>
    <bpmn:userTask id="P_Conduct" name="Conduct Portfolio Architecture Review"/>
    <bpmn:exclusiveGateway id="P_Consult" name="Specialist Consultation Required?"/>
    <bpmn:userTask id="P_ConsultTask" name="Obtain Specialist/ODT Consultation"/>
    <bpmn:userTask id="P_Record" name="Record Portfolio Review Findings in Jira"/>
    <bpmn:exclusiveGateway id="G_Escalate" name="SA Review Required?"/>
    <bpmn:userTask id="T_RecordAPTApproval" name="Record Portfolio Review Approval in Jira"/>
    <bpmn:userTask id="S_Escalate" name="Assign Escalated Review to SA"/>
    <bpmn:userTask id="S_Validate" name="Validate Escalated Review Documentation"/>
    <bpmn:exclusiveGateway id="S_Ready" name="Review Ready?"/>
    <bpmn:userTask id="S_UpdateInfo" name="Request Required Information"/>
    <bpmn:userTask id="S_InProgress" name="Set SA Review to In Progress"/>
    <bpmn:userTask id="S_Schedule" name="Schedule SA Review"/>
    <bpmn:userTask id="S_Conduct" name="Conduct SA Review"/>
    <bpmn:exclusiveGateway id="S_Consult" name="Specialist Consultation Required?"/>
    <bpmn:userTask id="S_ConsultTask" name="Obtain Specialist/ODT Consultation"/>
    <bpmn:exclusiveGateway id="S_Approved" name="SA Approval Granted?"/>
    <bpmn:userTask id="S_RecordApprove" name="Record SA Approval in Jira"/>
    <bpmn:userTask id="S_RecordChanges" name="Record Required Changes in Jira"/>
    <bpmn:userTask id="T_SAEndorse" name="Obtain SA Approval for Tollgate Governance"/>
    <bpmn:exclusiveGateway id="G_SAEndorsed" name="SA Approval Granted?"/>
    <bpmn:userTask id="T_ReturnChanges" name="Return Required Changes to Portfolio Reviewer"/>
    <bpmn:userTask id="G_CreateTracking" name="Create or Update Tollgate Governance Record"/>
    <bpmn:userTask id="G_CreateTask" name="Create ITG Tollgate Task and Notify Contact"/>
    <bpmn:userTask id="G_VerifyApproval" name="Verify SA Approval"/>
    <bpmn:userTask id="G_VerifyArtifacts" name="Verify Required Review Steps and Artifacts"/>
    <bpmn:userTask id="G_Record" name="Record Tollgate Governance Outcome"/>
    <bpmn:exclusiveGateway id="G_RecordComplete" name="Tollgate Governance Record Complete?"/>
    <bpmn:userTask id="T_CorrectGovRecord" name="Complete or Correct Tollgate Governance Record"/>
    <bpmn:userTask id="C_Record" name="Record Final Review Status in Parent Jira"/>
    <bpmn:userTask id="C_Notify" name="Notify Review Stakeholders"/>
    <bpmn:userTask id="C_Close" name="Set ar-complete and Close Jira Tasks"/>
    <bpmn:endEvent id="End_Complete" name="Architecture Review Completed"/>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Review" targetRef="P_Submit"/>
    <bpmn:sequenceFlow id="F02" sourceRef="P_Submit" targetRef="P_CreateJira"/>
    <bpmn:sequenceFlow id="F03" sourceRef="P_CreateJira" targetRef="P_CreateSub"/>
    <bpmn:sequenceFlow id="F04" sourceRef="P_CreateSub" targetRef="P_Upload"/>
    <bpmn:sequenceFlow id="F05" sourceRef="P_Upload" targetRef="P_Validate"/>
    <bpmn:sequenceFlow id="F06" sourceRef="P_Validate" targetRef="P_Ready"/>
    <bpmn:sequenceFlow id="F07Y" sourceRef="P_Ready" targetRef="P_InProgress" name="Yes"/>
    <bpmn:sequenceFlow id="F07N" sourceRef="P_Ready" targetRef="P_UpdateInfo" name="No"/>
    <bpmn:sequenceFlow id="F08" sourceRef="P_UpdateInfo" targetRef="P_Validate"/>
    <bpmn:sequenceFlow id="F09" sourceRef="P_InProgress" targetRef="P_Schedule"/>
    <bpmn:sequenceFlow id="F10" sourceRef="P_Schedule" targetRef="P_Conduct"/>
    <bpmn:sequenceFlow id="F11" sourceRef="P_Conduct" targetRef="P_Consult"/>
    <bpmn:sequenceFlow id="F12Y" sourceRef="P_Consult" targetRef="P_ConsultTask" name="Yes"/>
    <bpmn:sequenceFlow id="F12N" sourceRef="P_Consult" targetRef="P_Record" name="No"/>
    <bpmn:sequenceFlow id="F13" sourceRef="P_ConsultTask" targetRef="P_Conduct"/>
    <bpmn:sequenceFlow id="F14" sourceRef="P_Record" targetRef="G_Escalate"/>
    <bpmn:sequenceFlow id="F15Y" sourceRef="G_Escalate" targetRef="S_Escalate" name="Yes"/>
    <bpmn:sequenceFlow id="F15N" sourceRef="G_Escalate" targetRef="T_RecordAPTApproval" name="No"/>
    <bpmn:sequenceFlow id="F16" sourceRef="T_RecordAPTApproval" targetRef="T_SAEndorse"/>
    <bpmn:sequenceFlow id="F17" sourceRef="T_SAEndorse" targetRef="G_SAEndorsed"/>
    <bpmn:sequenceFlow id="F18Y" sourceRef="G_SAEndorsed" targetRef="G_CreateTracking" name="Yes"/>
    <bpmn:sequenceFlow id="F18N" sourceRef="G_SAEndorsed" targetRef="T_ReturnChanges" name="No"/>
    <bpmn:sequenceFlow id="F19" sourceRef="S_Escalate" targetRef="S_Validate"/>
    <bpmn:sequenceFlow id="F20" sourceRef="S_Validate" targetRef="S_Ready"/>
    <bpmn:sequenceFlow id="F21Y" sourceRef="S_Ready" targetRef="S_InProgress" name="Yes"/>
    <bpmn:sequenceFlow id="F21N" sourceRef="S_Ready" targetRef="S_UpdateInfo" name="No"/>
    <bpmn:sequenceFlow id="F22" sourceRef="S_UpdateInfo" targetRef="S_Validate"/>
    <bpmn:sequenceFlow id="F23" sourceRef="S_InProgress" targetRef="S_Schedule"/>
    <bpmn:sequenceFlow id="F24" sourceRef="S_Schedule" targetRef="S_Conduct"/>
    <bpmn:sequenceFlow id="F25" sourceRef="S_Conduct" targetRef="S_Consult"/>
    <bpmn:sequenceFlow id="F26Y" sourceRef="S_Consult" targetRef="S_ConsultTask" name="Yes"/>
    <bpmn:sequenceFlow id="F26N" sourceRef="S_Consult" targetRef="S_Approved" name="No"/>
    <bpmn:sequenceFlow id="F27" sourceRef="S_ConsultTask" targetRef="S_Conduct"/>
    <bpmn:sequenceFlow id="F28Y" sourceRef="S_Approved" targetRef="S_RecordApprove" name="Yes"/>
    <bpmn:sequenceFlow id="F28N" sourceRef="S_Approved" targetRef="S_RecordChanges" name="No"/>
    <bpmn:sequenceFlow id="F29" sourceRef="S_RecordApprove" targetRef="G_CreateTracking"/>
    <bpmn:sequenceFlow id="F30" sourceRef="S_RecordChanges" targetRef="T_ReturnChanges"/>
    <bpmn:sequenceFlow id="F31" sourceRef="T_ReturnChanges" targetRef="P_Submit"/>
    <bpmn:sequenceFlow id="F32" sourceRef="G_CreateTracking" targetRef="G_CreateTask"/>
    <bpmn:sequenceFlow id="F33" sourceRef="G_CreateTask" targetRef="G_VerifyApproval"/>
    <bpmn:sequenceFlow id="F34" sourceRef="G_VerifyApproval" targetRef="G_VerifyArtifacts"/>
    <bpmn:sequenceFlow id="F35" sourceRef="G_VerifyArtifacts" targetRef="G_Record"/>
    <bpmn:sequenceFlow id="F36" sourceRef="G_Record" targetRef="G_RecordComplete"/>
    <bpmn:sequenceFlow id="F37Y" sourceRef="G_RecordComplete" targetRef="C_Record" name="Yes"/>
    <bpmn:sequenceFlow id="F37N" sourceRef="G_RecordComplete" targetRef="T_CorrectGovRecord" name="No"/>
    <bpmn:sequenceFlow id="F38" sourceRef="T_CorrectGovRecord" targetRef="G_VerifyArtifacts"/>
    <bpmn:sequenceFlow id="F39" sourceRef="C_Record" targetRef="C_Notify"/>
    <bpmn:sequenceFlow id="F40" sourceRef="C_Notify" targetRef="C_Close"/>
    <bpmn:sequenceFlow id="F41" sourceRef="C_Close" targetRef="End_Complete"/>
  </bpmn:process>
