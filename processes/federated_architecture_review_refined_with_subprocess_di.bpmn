    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="Diagram_Portfolio">
    <bpmndi:BPMNPlane id="Plane_Portfolio" bpmnElement="SP_Portfolio">
      <bpmndi:BPMNShape id="PDI_Start" bpmnElement="P_Start">
        <dc:Bounds x="90" y="190" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PDI_Submit" bpmnElement="P_Submit">
        <dc:Bounds x="160" y="165" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PDI_CreateJira" bpmnElement="P_CreateJira">
        <dc:Bounds x="350" y="165" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PDI_CreateSub" bpmnElement="P_CreateSub">
        <dc:Bounds x="540" y="165" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PDI_Upload" bpmnElement="P_Upload">
        <dc:Bounds x="730" y="165" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PDI_Validate" bpmnElement="P_Validate">
        <dc:Bounds x="920" y="165" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PDI_Ready" bpmnElement="P_Ready" isMarkerVisible="true">
        <dc:Bounds x="1110" y="180" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PDI_InProgress" bpmnElement="P_InProgress">
        <dc:Bounds x="1210" y="165" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PDI_Schedule" bpmnElement="P_Schedule">
        <dc:Bounds x="1410" y="165" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PDI_Conduct" bpmnElement="P_Conduct">
        <dc:Bounds x="1610" y="165" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PDI_Consult" bpmnElement="P_Consult" isMarkerVisible="true">
        <dc:Bounds x="1820" y="180" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PDI_Record" bpmnElement="P_Record">
        <dc:Bounds x="1930" y="165" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PDI_End" bpmnElement="P_End">
        <dc:Bounds x="2140" y="187" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PDI_UpdateInfo" bpmnElement="P_UpdateInfo">
        <dc:Bounds x="1010" y="330" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PDI_ConsultTask" bpmnElement="P_ConsultTask">
        <dc:Bounds x="1720" y="330" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="PDE_PF1" bpmnElement="PF1">
        <di:waypoint x="126" y="208" />
        <di:waypoint x="160" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PDE_PF2" bpmnElement="PF2">
        <di:waypoint x="310" y="205" />
        <di:waypoint x="350" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PDE_PF3" bpmnElement="PF3">
        <di:waypoint x="500" y="205" />
        <di:waypoint x="540" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PDE_PF4" bpmnElement="PF4">
        <di:waypoint x="690" y="205" />
        <di:waypoint x="730" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PDE_PF5" bpmnElement="PF5">
