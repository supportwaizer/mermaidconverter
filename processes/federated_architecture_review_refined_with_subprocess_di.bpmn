      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E6N" bpmnElement="F6N">
        <di:waypoint x="1080" y="355" />
        <di:waypoint x="1130" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E7" bpmnElement="F7">
        <di:waypoint x="1130" y="430" />
