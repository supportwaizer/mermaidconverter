        <dc:Bounds x="3845" y="712" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F01_edge" bpmnElement="F01">
        <di:waypoint x="196" y="153"/>
        <di:waypoint x="230" y="152"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F02_edge" bpmnElement="F02">
        <di:waypoint x="365" y="152"/>
        <di:waypoint x="405" y="152"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F03_edge" bpmnElement="F03">
        <di:waypoint x="550" y="152"/>
        <di:waypoint x="590" y="152"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F04_edge" bpmnElement="F04">
        <di:waypoint x="735" y="152"/>
        <di:waypoint x="775" y="152"/>
