<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_FederatedArchitectureReview_v2" targetNamespace="http://example.com/federated-architecture-review/v2">
  <bpmn:collaboration id="Collaboration_FAR">
    <bpmn:participant id="Participant_FAR" name="Federated Architecture Review" processRef="Process_FAR"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_FAR" name="Federated Architecture Review - Enriched with Manual Tracking Tasks" isExecutable="false">
    <bpmn:laneSet id="LaneSet_FAR">
      <bpmn:lane id="Lane_APT" name="APT / Portfolio Review">
        <bpmn:flowNodeRef>Start_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CreateJira</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CreateAPTSubtask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_UploadDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ValidateAPT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_APTReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_UpdateInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_MarkAPTInProgress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ScheduleAPT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ConductAPT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ApproveAPT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordAPT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_NotifySAODT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CreatePC2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CreateITGSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_UpdateGovDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_UpdateSolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordGov</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CloseJira</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SA" name="Solution Architecture (SA)">
        <bpmn:flowNodeRef>T_ValidateSA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_SAReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_MarkSAInProgress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ScheduleSA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ConductSA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ODTRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CreateODTSubs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordODT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_SAApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_NotifyAPTODT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ODT" name="Operational Domain Team (ODT)">
        <bpmn:flowNodeRef>T_ODTReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ODTApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_DocODT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ITG" name="IT Governance (ITG)">
        <bpmn:flowNodeRef>T_GovReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_GovApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_DocGovApprove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_DocGovReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_TechRereview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Complete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Review" name="Review Request Initiated"/>
    <bpmn:userTask id="T_Submit" name="[1] Submit Review Request via MS Form"/>
    <bpmn:userTask id="T_CreateJira" name="[1a] Create Jira Architecture Review Record"/>
    <bpmn:userTask id="T_CreateAPTSubtask" name="[1b] Create APT Review Sub-task"/>
    <bpmn:userTask id="T_UploadDocs" name="[1c] Upload Supporting Documentation"/>
    <bpmn:userTask id="T_ValidateAPT" name="[2] Validate Request Documentation"/>
    <bpmn:exclusiveGateway id="G_APTReady" name="[3] Ready for Review?" default="F07N"/>
    <bpmn:userTask id="T_UpdateInfo" name="Provide Missing / Updated Information"/>
    <bpmn:userTask id="T_MarkAPTInProgress" name="Mark Portfolio Review In Progress"/>
    <bpmn:userTask id="T_ScheduleAPT" name="Schedule Review (if required)"/>
    <bpmn:userTask id="T_ConductAPT" name="[4] Conduct Portfolio Review"/>
    <bpmn:exclusiveGateway id="G_Escalate" name="[5] Require Escalation?"/>
    <bpmn:userTask id="T_ApproveAPT" name="[7] Approve Review"/>
    <bpmn:userTask id="T_RecordAPT" name="Record Portfolio Review Decision in Jira"/>
    <bpmn:userTask id="T_NotifySAODT" name="[8] Notify SA and ODT(s)"/>
    <bpmn:userTask id="T_Escalate" name="[6] Escalate Review to SA / Update Jira Assignment"/>
    <bpmn:userTask id="T_ValidateSA" name="[6a] Validate Escalated Request Documentation"/>
    <bpmn:exclusiveGateway id="G_SAReady" name="[6b] Ready for Review?" default="F18N"/>
    <bpmn:userTask id="T_MarkSAInProgress" name="Mark SA Review In Progress"/>
    <bpmn:userTask id="T_ScheduleSA" name="Schedule Architecture Review"/>
    <bpmn:userTask id="T_ConductSA" name="[6c] Conduct Escalated Request SA Review"/>
    <bpmn:exclusiveGateway id="G_ODTRequired" name="[6d] Require ODT Advice?"/>
    <bpmn:userTask id="T_CreateODTSubs" name="Create Required ODT Sub-task(s)"/>
    <bpmn:userTask id="T_RecordODT" name="Record ODT Decision in Parent Jira"/>
    <bpmn:exclusiveGateway id="G_SAApproved" name="[6e] Review Approved?"/>
    <bpmn:userTask id="T_NotifyAPTODT" name="[8a] Notify APT and ODT(s)"/>
    <bpmn:userTask id="T_ODTReview" name="Conduct ODT Review"/>
    <bpmn:exclusiveGateway id="G_ODTApproved" name="ODT Approved?"/>
    <bpmn:userTask id="T_DocODT" name="Document ODT Approval / Decision"/>
    <bpmn:userTask id="T_CreatePC2" name="Create PC2 Governance Tracking Entry"/>
    <bpmn:userTask id="T_CreateITGSub" name="Create IT Governance Sub-task and Notify Contact"/>
    <bpmn:userTask id="T_GovReview" name="[9] Conduct Governance Review / Audit Tollgate"/>
    <bpmn:exclusiveGateway id="G_GovApproved" name="Governance Approved?"/>
    <bpmn:userTask id="T_DocGovApprove" name="Document Final Governance Approval"/>
    <bpmn:userTask id="T_DocGovReject" name="Document Governance Rejection / Required Changes"/>
    <bpmn:exclusiveGateway id="G_TechRereview" name="Technical Re-review Required?"/>
    <bpmn:userTask id="T_UpdateGovDocs" name="Update Governance Documentation"/>
    <bpmn:userTask id="T_UpdateSolution" name="Update Solution / Architecture Documentation"/>
    <bpmn:userTask id="T_RecordGov" name="Record Governance Decision in Parent Jira"/>
    <bpmn:userTask id="T_CloseJira" name="Mark ar-complete and Close Jira Tasks"/>
    <bpmn:endEvent id="End_Complete" name="Review Completed"/>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Review" targetRef="T_Submit"/>
    <bpmn:sequenceFlow id="F02" sourceRef="T_Submit" targetRef="T_CreateJira"/>
    <bpmn:sequenceFlow id="F03" sourceRef="T_CreateJira" targetRef="T_CreateAPTSubtask"/>
    <bpmn:sequenceFlow id="F04" sourceRef="T_CreateAPTSubtask" targetRef="T_UploadDocs"/>
    <bpmn:sequenceFlow id="F05" sourceRef="T_UploadDocs" targetRef="T_ValidateAPT"/>
    <bpmn:sequenceFlow id="F06" sourceRef="T_ValidateAPT" targetRef="G_APTReady"/>
    <bpmn:sequenceFlow id="F07Y" sourceRef="G_APTReady" targetRef="T_MarkAPTInProgress" name="Yes"/>
    <bpmn:sequenceFlow id="F07N" sourceRef="G_APTReady" targetRef="T_UpdateInfo" name="No - Revise Documentation"/>
    <bpmn:sequenceFlow id="F08" sourceRef="T_UpdateInfo" targetRef="T_UploadDocs"/>
    <bpmn:sequenceFlow id="F09" sourceRef="T_MarkAPTInProgress" targetRef="T_ScheduleAPT"/>
    <bpmn:sequenceFlow id="F10" sourceRef="T_ScheduleAPT" targetRef="T_ConductAPT"/>
    <bpmn:sequenceFlow id="F11" sourceRef="T_ConductAPT" targetRef="G_Escalate"/>
    <bpmn:sequenceFlow id="F12N" sourceRef="G_Escalate" targetRef="T_ApproveAPT" name="No"/>
    <bpmn:sequenceFlow id="F12Y" sourceRef="G_Escalate" targetRef="T_Escalate" name="Yes"/>
    <bpmn:sequenceFlow id="F13" sourceRef="T_ApproveAPT" targetRef="T_RecordAPT"/>
    <bpmn:sequenceFlow id="F14" sourceRef="T_RecordAPT" targetRef="T_NotifySAODT"/>
    <bpmn:sequenceFlow id="F15" sourceRef="T_NotifySAODT" targetRef="T_CreatePC2"/>
    <bpmn:sequenceFlow id="F16" sourceRef="T_Escalate" targetRef="T_ValidateSA"/>
    <bpmn:sequenceFlow id="F17" sourceRef="T_ValidateSA" targetRef="G_SAReady"/>
    <bpmn:sequenceFlow id="F18Y" sourceRef="G_SAReady" targetRef="T_MarkSAInProgress" name="Yes"/>
    <bpmn:sequenceFlow id="F18N" sourceRef="G_SAReady" targetRef="T_UpdateInfo" name="No - Revise Documentation"/>
    <bpmn:sequenceFlow id="F19" sourceRef="T_MarkSAInProgress" targetRef="T_ScheduleSA"/>
    <bpmn:sequenceFlow id="F20" sourceRef="T_ScheduleSA" targetRef="T_ConductSA"/>
    <bpmn:sequenceFlow id="F21" sourceRef="T_ConductSA" targetRef="G_ODTRequired"/>
    <bpmn:sequenceFlow id="F22N" sourceRef="G_ODTRequired" targetRef="G_SAApproved" name="No"/>
    <bpmn:sequenceFlow id="F22Y" sourceRef="G_ODTRequired" targetRef="T_CreateODTSubs" name="Yes"/>
    <bpmn:sequenceFlow id="F23" sourceRef="T_CreateODTSubs" targetRef="T_ODTReview"/>
    <bpmn:sequenceFlow id="F24" sourceRef="T_ODTReview" targetRef="G_ODTApproved"/>
    <bpmn:sequenceFlow id="F25Y" sourceRef="G_ODTApproved" targetRef="T_DocODT" name="Yes"/>
    <bpmn:sequenceFlow id="F25N" sourceRef="G_ODTApproved" targetRef="T_UpdateInfo" name="No - Rework"/>
    <bpmn:sequenceFlow id="F26" sourceRef="T_DocODT" targetRef="T_RecordODT"/>
    <bpmn:sequenceFlow id="F27" sourceRef="T_RecordODT" targetRef="G_SAApproved"/>
    <bpmn:sequenceFlow id="F28Y" sourceRef="G_SAApproved" targetRef="T_NotifyAPTODT" name="Yes"/>
    <bpmn:sequenceFlow id="F28N" sourceRef="G_SAApproved" targetRef="T_UpdateSolution" name="No - Suggested Changes"/>
    <bpmn:sequenceFlow id="F29" sourceRef="T_UpdateSolution" targetRef="T_ValidateAPT"/>
    <bpmn:sequenceFlow id="F30" sourceRef="T_NotifyAPTODT" targetRef="T_CreatePC2"/>
    <bpmn:sequenceFlow id="F31" sourceRef="T_CreatePC2" targetRef="T_CreateITGSub"/>
    <bpmn:sequenceFlow id="F32" sourceRef="T_CreateITGSub" targetRef="T_GovReview"/>
    <bpmn:sequenceFlow id="F33" sourceRef="T_GovReview" targetRef="G_GovApproved"/>
    <bpmn:sequenceFlow id="F34Y" sourceRef="G_GovApproved" targetRef="T_DocGovApprove" name="Yes"/>
    <bpmn:sequenceFlow id="F34N" sourceRef="G_GovApproved" targetRef="T_DocGovReject" name="No"/>
    <bpmn:sequenceFlow id="F35" sourceRef="T_DocGovApprove" targetRef="T_RecordGov"/>
    <bpmn:sequenceFlow id="F36" sourceRef="T_RecordGov" targetRef="T_CloseJira"/>
    <bpmn:sequenceFlow id="F37" sourceRef="T_CloseJira" targetRef="End_Complete"/>
    <bpmn:sequenceFlow id="F38" sourceRef="T_DocGovReject" targetRef="G_TechRereview"/>
    <bpmn:sequenceFlow id="F39N" sourceRef="G_TechRereview" targetRef="T_UpdateGovDocs" name="No - Documentation Only"/>
    <bpmn:sequenceFlow id="F39Y" sourceRef="G_TechRereview" targetRef="T_UpdateSolution" name="Yes - Material Change"/>
    <bpmn:sequenceFlow id="F40" sourceRef="T_UpdateGovDocs" targetRef="T_GovReview"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_FAR">
    <bpmndi:BPMNPlane id="Plane_FAR" bpmnElement="Collaboration_FAR">
      <bpmndi:BPMNShape id="ParticipantShape" bpmnElement="Participant_FAR" isHorizontal="true">
        <dc:Bounds x="90" y="70" width="3830" height="830"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_APT_shape" bpmnElement="Lane_APT" isHorizontal="true">
        <dc:Bounds x="120" y="70" width="3800" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SA_shape" bpmnElement="Lane_SA" isHorizontal="true">
        <dc:Bounds x="120" y="290" width="3800" height="190"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ODT_shape" bpmnElement="Lane_ODT" isHorizontal="true">
